{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug hello (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "build",
            "console": "integratedTerminal",
            "linux": {
                "program": "${workspaceFolder}/build/hello",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/build/hello.exe",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
            }
        }
    ]
}